# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# URL publica do servico. Usada na URI dos metadados do certificado.
# Em producao aponta para o dominio real. Em desenvolvimento, se voce quiser que
# um indexador externo consiga ler os metadados, use um tunel (ngrok, cloudflared)
# e coloque a URL do tunel aqui. Nunca deixe localhost em producao.
PUBLIC_BASE_URL=http://localhost:4000

# ─── Banco de dados ──────────────────────────────────────────────────────────
# Sem DATABASE_URL o sistema usa PGlite embarcado (nao precisa instalar nada).
# Com DATABASE_URL usa Postgres de verdade (Supabase, RDS, container local).
# Supabase: use a connection string do pooler (porta 6543), nao a direta.
# DATABASE_URL=postgresql://postgres.abcdefgh:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
PGLITE_DIR=.uniwork/pgdata
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TX_TIMEOUT_MS=30000

# ─── Seguranca ───────────────────────────────────────────────────────────────
# Chave mestra que cifra o segredo de cada conta (AES-256-GCM + scrypt).
# Em producao ela vem de um gerenciador de segredos, nunca de arquivo.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_MASTER_KEY=
SESSION_TTL_HOURS=720

# ─── Solana ──────────────────────────────────────────────────────────────────
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Helius habilita a DAS API (confirmacao independente do certificado) e um RPC
# mais estavel. Sem chave, a verificacao pelo indexador fica indisponivel e o
# doctor avisa. https://dashboard.helius.dev
HELIUS_API_KEY=

# Arquivo de estado do bootstrap de devnet (conta da plataforma, mint de teste,
# merkle tree). Contem chave privada: nunca versionar.
PLATFORM_STATE_FILE=.uniwork/platform.json

# ─── Escrow ──────────────────────────────────────────────────────────────────
# vault  = cofre custodial por vaga, funciona sem deploy (fallback)
# anchor = programa Anchor deployado, autoridade do programa (padrao alvo)
ESCROW_DRIVER=vault
ESCROW_PROGRAM_ID=
PLATFORM_FEE_BPS=500

# ─── Certificado ─────────────────────────────────────────────────────────────
# bubblegum = compressed NFT de verdade (padrao)
# memo      = fallback registrado na rede, reprocessado depois ate virar cNFT
CERT_DRIVER=bubblegum
