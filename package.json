{
  "name": "uniwork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Uni.work — marketplace de trampos curtos para universitarios, com escrow e certificado verificavel na Solana (devnet)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "node src/server.js",
