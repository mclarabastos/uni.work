    "express": "^4.21.2",
    "nodemailer": "^9.0.6",
    "pg": "^8.13.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@coral-xyz/anchor": "^0.32.1",
    "axe-core": "^4.13.0",
    "bs58": "^6.0.0",
    "playwright": "^1.62.1"
  }
